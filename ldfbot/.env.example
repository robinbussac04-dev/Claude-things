# Discord
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=1567996859639799979
OWNER_ID=1145789677601824849

# Web dashboard
PORT=3000
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
DASHBOARD_PASSWORD_HASH=
# Random 32-char string for session signing: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: restrict to HTTPS cookies (set to 1 once nginx + TLS are up)
COOKIE_SECURE=0

# PWF Auth integration (optional — leave empty to disable /redeem)
PWF_APP_SECRET=
CUSTOMER_ROLE_ID=
REDEEM_LOG_CHANNEL_ID=

# Giveaways log channel (optional)
GIVEAWAY_LOG_CHANNEL_ID=

# Verify / restore (OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_URL=https://ldfbot.duckdns.org
VERIFY_ROLE_ID=
# Comma-separated role ids to remove on verify (e.g. an "Unverified" role)
VERIFY_REMOVE_ROLE_IDS=
